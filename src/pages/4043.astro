---
// src/pages/404.astro
---

<!doctype html>
<html lang='pl'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>404 – Strona nie istnieje</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400&display=swap'
      rel='stylesheet'
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --cream: #f0ede8;
        --dark: #1a1a18;
        --wood-light: #d4a96a;
        --wood-mid: #b8865a;
        --wood-dark: #8b6040;
        --rope: #8b6914;
        --sign-bg: #1e1e1e;
        --sign-text: #f5f0e8;
        --accent: #c8903a;
        --leaf: #6b8c52;
      }

      html,
      body {
        height: 100%;
      }

      body {
        background-color: var(--cream);
        font-family: 'Lato', sans-serif;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* ── LEAVES ── */
      .leaves-container {
        position: fixed;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
      }

      .leaf {
        position: absolute;
        width: 22px;
        height: 12px;
        background: var(--leaf);
        border-radius: 50% 0 50% 0;
        opacity: 0.75;
        animation: fall linear infinite;
      }

      .leaf::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 1px;
        background: rgba(255, 255, 255, 0.25);
        transform: translateY(-50%) rotate(-10deg);
      }

      @keyframes fall {
        0% {
          transform: translateY(-60px) translateX(0) rotate(0deg);
          opacity: 0.8;
        }
        50% {
          transform: translateY(45vh) translateX(30px) rotate(120deg);
          opacity: 0.65;
        }
        100% {
          transform: translateY(95vh) translateX(-10px) rotate(240deg);
          opacity: 0;
        }
      }

      /* stagger & position every leaf differently */
      .leaf:nth-child(1) {
        left: 8%;
        width: 18px;
        height: 10px;
        animation-duration: 7s;
        animation-delay: 0s;
      }
      .leaf:nth-child(2) {
        left: 18%;
        width: 24px;
        height: 13px;
        animation-duration: 9s;
        animation-delay: 1.2s;
      }
      .leaf:nth-child(3) {
        left: 32%;
        width: 16px;
        height: 9px;
        animation-duration: 6s;
        animation-delay: 2.5s;
      }
      .leaf:nth-child(4) {
        left: 55%;
        width: 20px;
        height: 11px;
        animation-duration: 8s;
        animation-delay: 0.7s;
      }
      .leaf:nth-child(5) {
        left: 68%;
        width: 26px;
        height: 14px;
        animation-duration: 10s;
        animation-delay: 3.1s;
      }
      .leaf:nth-child(6) {
        left: 79%;
        width: 18px;
        height: 10px;
        animation-duration: 7.5s;
        animation-delay: 1.8s;
      }
      .leaf:nth-child(7) {
        left: 88%;
        width: 22px;
        height: 12px;
        animation-duration: 9s;
        animation-delay: 4s;
      }
      .leaf:nth-child(8) {
        left: 42%;
        width: 15px;
        height: 8px;
        animation-duration: 6.5s;
        animation-delay: 2s;
      }
      .leaf:nth-child(9) {
        left: 72%;
        width: 20px;
        height: 11px;
        animation-duration: 8.5s;
        animation-delay: 5.2s;
      }
      .leaf:nth-child(10) {
        left: 12%;
        width: 23px;
        height: 13px;
        animation-duration: 11s;
        animation-delay: 6s;
      }
      .leaf:nth-child(11) {
        left: 93%;
        width: 17px;
        height: 9px;
        animation-duration: 7s;
        animation-delay: 3.5s;
      }
      .leaf:nth-child(12) {
        left: 60%;
        width: 21px;
        height: 12px;
        animation-duration: 9.5s;
        animation-delay: 0.3s;
      }

      /* ── MAIN SCENE ── */
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px 40px;
        position: relative;
        z-index: 1;
      }

      .scene {
        display: flex;
        align-items: flex-start;
        gap: 0;
        position: relative;
        width: 100%;
        max-width: 820px;
      }

      /* ── CRANE (SVG) ── */
      .crane-wrap {
        flex-shrink: 0;
        width: 240px;
        position: relative;
      }

      .crane-wrap svg {
        width: 100%;
        height: auto;
        display: block;
      }

      /* wobble on crane base */
      @keyframes wobble {
        0%,
        100% {
          transform: rotate(0deg);
        }
        25% {
          transform: rotate(0.6deg);
        }
        75% {
          transform: rotate(-0.6deg);
        }
      }

      /* ── SIGNS COLUMN ── */
      .signs-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding-top: 30px;
        flex: 1;
      }

      /* rope from crane arm to 404-sign */
      .rope-top {
        width: 2px;
        height: 60px;
        background: linear-gradient(to bottom, var(--rope), #a07820);
        margin: 0 auto;
      }

      /* ── 404 SIGN ── */
      .sign-404 {
        background: #1c1c1c;
        background-image:
          radial-gradient(ellipse at 20% 30%, #2e2e2e 0%, transparent 60%),
          radial-gradient(ellipse at 80% 70%, #111 0%, transparent 55%);
        color: var(--sign-text);
        padding: 18px 40px;
        border-radius: 4px;
        box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.45),
          inset 0 1px 0 rgba(255, 255, 255, 0.05);
        animation: swing 4s ease-in-out infinite;
        transform-origin: top center;
      }

      .sign-404 span {
        font-family: 'Playfair Display', serif;
        font-size: clamp(3rem, 8vw, 5rem);
        font-weight: 700;
        letter-spacing: 0.04em;
        display: block;
        line-height: 1;
      }

      @keyframes swing {
        0%,
        100% {
          transform: rotate(-3deg);
        }
        50% {
          transform: rotate(3deg);
        }
      }

      /* rope between signs */
      .rope-mid {
        width: 2px;
        height: 40px;
        background: linear-gradient(to bottom, var(--rope), #a07820);
        margin: 0 auto;
      }

      /* ── MESSAGE SIGN ── */
      .sign-msg {
        background: #1c1c1c;
        background-image:
          radial-gradient(ellipse at 15% 20%, #2e2e2e 0%, transparent 50%),
          radial-gradient(ellipse at 85% 80%, #0e0e0e 0%, transparent 50%);
        color: var(--sign-text);
        padding: 32px 40px;
        border-radius: 4px;
        max-width: 380px;
        text-align: center;
        box-shadow:
          0 12px 40px rgba(0, 0, 0, 0.5),
          inset 0 1px 0 rgba(255, 255, 255, 0.05);
        animation: swing2 5s ease-in-out infinite;
        transform-origin: top center;
      }

      @keyframes swing2 {
        0%,
        100% {
          transform: rotate(2deg);
        }
        50% {
          transform: rotate(-2deg);
        }
      }

      .sign-msg h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        font-weight: 700;
        margin-bottom: 12px;
        line-height: 1.2;
      }

      .sign-msg p {
        font-size: 0.95rem;
        font-weight: 300;
        line-height: 1.6;
        opacity: 0.85;
        margin-bottom: 28px;
      }

      .btn-home {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--accent);
        color: var(--sign-text);
        background: transparent;
        padding: 10px 24px;
        border-radius: 3px;
        font-family: 'Lato', sans-serif;
        font-size: 0.875rem;
        letter-spacing: 0.06em;
        text-decoration: none;
        transition:
          background 0.25s,
          color 0.25s;
        cursor: pointer;
      }

      .btn-home:hover {
        background: var(--accent);
        color: var(--dark);
      }

      .btn-home svg {
        width: 14px;
        height: 14px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── BOTTOM INFO STRIP ── */
      .info-strip {
        background: var(--cream);
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        padding: 40px 20px;
        z-index: 1;
        position: relative;
      }

      .info-grid {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        text-align: center;
      }

      .info-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }

      .info-item svg {
        width: 28px;
        height: 28px;
        stroke: var(--wood-dark);
        fill: none;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .info-item strong {
        font-family: 'Playfair Display', serif;
        font-size: 0.95rem;
        color: var(--dark);
        display: block;
      }

      .info-item p {
        font-size: 0.8rem;
        color: #666;
        line-height: 1.5;
        font-weight: 300;
      }

      /* ── FOOTER ── */
      footer {
        background: var(--dark);
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
        padding: 20px;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        font-weight: 300;
        z-index: 1;
        position: relative;
      }

      /* ── RESPONSIVE ── */
      @media (max-width: 640px) {
        .crane-wrap {
          width: 160px;
        }
        .info-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .sign-msg {
          padding: 24px 24px;
        }
      }
    </style>
  </head>
  <body>
    <!-- Falling leaves -->
    <div class='leaves-container' aria-hidden='true'>
      <div class='leaf'></div><div class='leaf'></div>
      <div class='leaf'></div><div class='leaf'></div>
      <div class='leaf'></div><div class='leaf'></div>
      <div class='leaf'></div><div class='leaf'></div>
      <div class='leaf'></div><div class='leaf'></div>
      <div class='leaf'></div><div class='leaf'></div>
    </div>

    <main>
      <div class='scene'>
        <!-- CRANE SVG -->
        <div class='crane-wrap'>
          <svg viewBox='0 0 200 520' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>
            <defs>
              <!-- wood grain gradient -->
              <linearGradient id='wg' x1='0' y1='0' x2='1' y2='0'>
                <stop offset='0%' stop-color='#c8945a'></stop>
                <stop offset='40%' stop-color='#dba96e'></stop>
                <stop offset='70%' stop-color='#c8935a'></stop>
                <stop offset='100%' stop-color='#b07840'></stop>
              </linearGradient>
              <linearGradient id='wgv' x1='0' y1='0' x2='0' y2='1'>
                <stop offset='0%' stop-color='#dba96e'></stop>
                <stop offset='50%' stop-color='#c8935a'></stop>
                <stop offset='100%' stop-color='#b07840'></stop>
              </linearGradient>
              <!-- bolt -->
              <radialGradient id='bolt' cx='50%' cy='40%'>
                <stop offset='0%' stop-color='#888'></stop>
                <stop offset='100%' stop-color='#444'></stop>
              </radialGradient>
            </defs>

            <!-- helper macro: bolt at cx,cy -->
            <!-- Vertical left post -->
            <rect x='28' y='30' width='16' height='460' rx='2' fill='url(#wgv)'></rect>
            <!-- Vertical right post -->
            <rect x='84' y='30' width='16' height='460' rx='2' fill='url(#wgv)'></rect>

            <!-- Horizontal cross-beams -->
            <!-- top -->
            <rect x='28' y='30' width='72' height='14' rx='2' fill='url(#wg)'></rect>
            <rect x='28' y='112' width='72' height='14' rx='2' fill='url(#wg)'></rect>
            <rect x='28' y='194' width='72' height='14' rx='2' fill='url(#wg)'></rect>
            <rect x='28' y='276' width='72' height='14' rx='2' fill='url(#wg)'></rect>
            <rect x='28' y='358' width='72' height='14' rx='2' fill='url(#wg)'></rect>
            <rect x='28' y='440' width='72' height='14' rx='2' fill='url(#wg)'></rect>
            <rect x='28' y='478' width='72' height='14' rx='2' fill='url(#wg)'></rect>

            <!-- Diagonal braces left-to-right (section 1) -->
            <line
              x1='36'
              y1='44'
              x2='92'
              y2='112'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <line
              x1='92'
              y1='44'
              x2='36'
              y2='112'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <!-- section 2 -->
            <line
              x1='36'
              y1='126'
              x2='92'
              y2='194'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <line
              x1='92'
              y1='126'
              x2='36'
              y2='194'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <!-- section 3 -->
            <line
              x1='36'
              y1='208'
              x2='92'
              y2='276'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <line
              x1='92'
              y1='208'
              x2='36'
              y2='276'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <!-- section 4 -->
            <line
              x1='36'
              y1='290'
              x2='92'
              y2='358'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <line
              x1='92'
              y1='290'
              x2='36'
              y2='358'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <!-- section 5 -->
            <line
              x1='36'
              y1='372'
              x2='92'
              y2='440'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>
            <line
              x1='92'
              y1='372'
              x2='36'
              y2='440'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>

            <!-- Crane arm (horizontal boom) -->
            <rect x='36' y='14' width='148' height='16' rx='3' fill='url(#wg)'></rect>
            <!-- Arm support diagonal -->
            <line
              x1='92'
              y1='30'
              x2='178'
              y2='16'
              stroke='url(#wg)'
              stroke-width='10'
              stroke-linecap='round'></line>

            <!-- Bolts at joints -->
            <circle cx='36' cy='44' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='44' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='112' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='112' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='126' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='126' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='194' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='194' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='208' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='208' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='276' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='276' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='290' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='290' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='358' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='358' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='372' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='372' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='440' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='440' r='5' fill='url(#bolt)'></circle>
            <circle cx='178' cy='22' r='5' fill='url(#bolt)'></circle>
            <circle cx='36' cy='22' r='5' fill='url(#bolt)'></circle>
            <circle cx='92' cy='30' r='5' fill='url(#bolt)'></circle>

            <!-- Rope hook point -->
            <line
              x1='178'
              y1='30'
              x2='178'
              y2='70'
              stroke='#8b6914'
              stroke-width='2.5'
              stroke-linecap='round'></line>
          </svg>
        </div>

        <!-- SIGNS -->
        <div class='signs-col'>
          <!-- top rope from arm -->
          <div class='rope-top'></div>

          <div class='sign-404' role='img' aria-label='Błąd 404'>
            <span>404</span>
          </div>

          <div class='rope-mid'></div>

          <div class='sign-msg'>
            <h1>Ups… Strona nie&nbsp;istnieje</h1>
            <p>Wygląda na to, że stronę, której szukasz,<br />porwał wiatr.</p>
            <a href='/' class='btn-home'>
              <svg viewBox='0 0 24 24'><polyline points='15 18 9 12 15 6'></polyline></svg>
              Wróć na stronę główną
            </a>
          </div>
        </div>
      </div>
    </main>

    <!-- INFO STRIP -->
    <section class='info-strip' aria-label='Pomocne wskazówki'>
      <div class='info-grid'>
        <div class='info-item'>
          <!-- link/chain icon -->
          <svg viewBox='0 0 24 24'>
            <path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'></path>
            <path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'></path>
          </svg>
          <strong>Sprawdź adres URL</strong>
          <p>Upewnij się, że adres został<br />wpisany poprawnie.</p>
        </div>

        <div class='info-item'>
          <!-- home icon -->
          <svg viewBox='0 0 24 24'>
            <path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'></path>
            <polyline points='9 22 9 12 15 12 15 22'></polyline>
          </svg>
          <strong>Wróć na stronę główną</strong>
          <p>Znajdziesz tam więcej<br />przydatnych informacji.</p>
        </div>

        <div class='info-item'>
          <!-- search icon -->
          <svg viewBox='0 0 24 24'>
            <circle cx='11' cy='11' r='8'></circle>
            <line x1='21' y1='21' x2='16.65' y2='16.65'></line>
          </svg>
          <strong>Skorzystaj z wyszukiwarki</strong>
          <p>Może znajdziesz to,<br />czego szukasz?</p>
        </div>

        <div class='info-item'>
          <!-- mail icon -->
          <svg viewBox='0 0 24 24'>
            <path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'
            ></path>
            <polyline points='22,6 12,13 2,6'></polyline>
          </svg>
          <strong>Skontaktuj się z nami</strong>
          <p>Jeśli problem nadal występuje,<br />jesteśmy do Twojej dyspozycji.</p>
        </div>
      </div>
    </section>

    <footer>&copy; 2024 Twoja Firma. Wszelkie prawa zastrzeżone.</footer>
  </body>
</html>
